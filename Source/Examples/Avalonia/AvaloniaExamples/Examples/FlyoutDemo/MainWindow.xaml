<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        xmlns:oxy="clr-namespace:OxyPlot.Avalonia;assembly=OxyPlot.Avalonia" 
        x:Class="AvaloniaExamples.Examples.FlyoutDemo.MainWindow"
        Title="FlyoutDemo" Height="480" Width="640">
	<DockPanel>
		<!-- Tooltip and Flyout share a model -->
		<TextBlock Text="ToolTip" FontSize="30" HorizontalAlignment="Center" DockPanel.Dock="Top" ToolTip.ShowDelay="0">
			<ToolTip.Tip>
				<oxy:PlotView Model="{Binding Plot1}" Width="200" Height="150" />
			</ToolTip.Tip>
		</TextBlock>
		
		<Button Content="Flyout" FontSize="30" HorizontalAlignment="Center" DockPanel.Dock="Top">
			<Button.Flyout>
				<Flyout Placement="Bottom">
					<oxy:PlotView Model="{Binding Plot1}" Width="300" Height="200" />
				</Flyout>
			</Button.Flyout>
		</Button>

		<!-- Left and Right share a PlotView -->
		<Button Content="Swap" FontSize="30" Command="{Binding SwapPlot}" HorizontalAlignment="Center" DockPanel.Dock="Top" />
		<Grid ColumnDefinitions="1*,1*">
			<Grid x:Name="Left" Grid.Column="0">
				<oxy:PlotView x:Name="SwappyPlot" Model="{Binding Plot2}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
			</Grid>
			<LayoutTransformControl Grid.Column="1" LayoutTransform="rotate(90deg)">
				<Grid x:Name="Right">
				</Grid>
			</LayoutTransformControl>
		</Grid>
	</DockPanel>
</Window>
